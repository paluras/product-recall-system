FROM golang:1.23

WORKDIR /app
COPY . .

RUN go mod download
RUN go build -o scraper ./cmd/scrapper
RUN go build -o notify ./cmd/notify

# Install cron
RUN apt-get update && apt-get install -y cron

# Make script executable
RUN chmod +x run-scraper-and-notify.sh

# Create entrypoint that writes env vars at runtime, then starts cron
RUN echo '#!/bin/bash\n\
# Write runtime env vars to a file cron can source\n\
env >> /etc/environment\n\
# Set up cron job\n\
echo "0 */2 * * * . /etc/environment; /app/run-scraper-and-notify.sh >> /proc/1/fd/1 2>&1" | crontab -\n\
# Start cron in foreground\n\
cron -f\n\
' > /app/entrypoint.sh

RUN chmod +x /app/entrypoint.sh

CMD ["/app/entrypoint.sh"]
